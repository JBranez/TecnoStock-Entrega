# Copia este archivo como .env en la raíz. Sustituye los placeholders.
APP_ENV=development
DB_SERVER=localhost
DB_PORT=1433
DB_SERVICE_NAME=MSSQL$SQLEXPRESS
DB_NAME=TecnoStockDB
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes

# Contraseña del login administrativo sa, configurada durante la instalación local.
# Solo se usa para inicializar la base y crear el usuario restringido de la API.
MSSQL_SA_PASSWORD=CAMBIAR_POR_LA_CLAVE_CONFIGURADA_EN_SQL_SERVER

# Cuenta de mínimo privilegio que usará la API; no utilizar sa.
DB_APP_USER=tecnostock_app
DB_APP_PASSWORD=CAMBIAR_POR_OTRA_CLAVE_FUERTE

# Secreto JWT: generar con secrets.token_urlsafe(48).
JWT_SECRET_KEY=GENERAR_UN_SECRETO_ALEATORIO_DE_48_BYTES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:4200

# Credenciales iniciales para datos de demostración.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CAMBIAR_ANTES_DE_SEMBRAR
